<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcuts for quickly jumping into the add-entry sheet. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_cat_plus"
        android:shortcutShortLabel="@string/shortcut_add_expense_short"
        android:shortcutLongLabel="@string/shortcut_add_expense_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.spendtracker"
            android:targetClass="com.spendtracker.MainActivity">
            <extra android:name="shortcut_action" android:value="add_expense" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="add_income"
        android:enabled="true"
        android:icon="@drawable/ic_cat_income"
        android:shortcutShortLabel="@string/shortcut_add_income_short"
        android:shortcutLongLabel="@string/shortcut_add_income_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.spendtracker"
            android:targetClass="com.spendtracker.MainActivity">
            <extra android:name="shortcut_action" android:value="add_income" />
        </intent>
    </shortcut>
</shortcuts>
